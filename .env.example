PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_FILE=./data/ssquare.sqlite
FREE_SHIPPING_MIN_ITEMS=5
FLAT_DELIVERY_FEE=40
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (order confirmations, password reset, abandoned-cart reminders) ---
# Without SMTP_HOST, emails are only printed to the server console and logged in the email_outbox table.
SITE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=S Square Elite <orders@yourdomain.com>
ADMIN_EMAIL=

# --- Shop rules ---
GIFT_WRAP_FEE=49
# 3-digit PIN prefixes the shop delivers to (ranges allowed). Default: Tamil Nadu.
SERVICEABLE_PIN_PREFIXES=600-643
FAST_PIN_PREFIXES=600-603
ABANDONED_CART_DELAY_HOURS=3
ABANDONED_CART_CHECK_MINUTES=15

# --- Uploads / links ---
# Public URL of this API (used in uploaded-image links). Defaults to the request host.
API_PUBLIC_URL=
INSTAGRAM_URL=
# Set when deployed behind a proxy/load balancer so rate limiting sees real client IPs (e.g. 1)
TRUST_PROXY=
# Optional: approved WhatsApp template with ONE body variable for admin order alerts
WHATSAPP_ADMIN_TEMPLATE=
